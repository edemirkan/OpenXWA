# Microsoft's Linux DXC release binaries are available for x86-64 only, so
# shader compilation always runs on a fixed amd64 build track regardless of
# which architecture is being targeted. shadercross/DXC only ever produces
# architecture-independent SPIR-V (.spv) bytecode, so this is safe: the tool
# itself never has to match the target CPU.
#
# Running that amd64 tool from within an aarch64 build stage requires the
# builder to have binfmt_misc/QEMU registered for foreign-architecture
# execution, e.g.:
#   docker run --privileged --rm tonistiigi/binfmt --install all
# `docker buildx create --use` with the default docker-container driver sets
# this up automatically on most CI runners.
#
# Build for aarch64:
#   docker buildx build --platform linux/arm64 -t openxwa:arm64 --load .
# Build for amd64 (unchanged from before):
#   docker buildx build --platform linux/amd64 -t openxwa:amd64 --load .

# Populated automatically by buildx ("amd64" or "arm64").
ARG TARGETARCH

# Target platform for the shipped binary and its runtime libraries. Override
# explicitly (e.g. --build-arg XWA_BUILD_PLATFORM=linux/arm64) if not using
# buildx's --platform flag.
ARG XWA_BUILD_PLATFORM=linux/${TARGETARCH}

# Fixed platform for the shader-compilation toolchain (DXC/shadercross),
# independent of XWA_BUILD_PLATFORM -- see note above.
ARG XWA_TOOLS_PLATFORM=linux/amd64

# Declared before the first FROM so every stage can see the same default --
# each stage that uses one of these still needs its own bare `ARG NAME` line
# to pull the value in (Docker only auto-inherits pre-FROM args into FROM
# lines themselves, not into RUN/etc. inside a stage).
ARG SDL_VERSION=3.4.14
ARG ZSTD_VERSION=1.5.7
ARG FFMPEG_VERSION=8.0.1
ARG SHADERCROSS_COMMIT=6b06e55c7c5d7e7a09a8a14f76e866dcfad5ab99

FROM --platform=${XWA_BUILD_PLATFORM} debian:bookworm-slim AS build-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        file \
        git \
        libasound2-dev \
        libdbus-1-dev \
        libdecor-0-dev \
        libdrm-dev \
        libegl1-mesa-dev \
        libgbm-dev \
        libgl-dev \
        libibus-1.0-dev \
        libncurses-dev \
        libpipewire-0.3-dev \
        libpulse-dev \
        libudev-dev \
        liburing-dev \
        libvulkan-dev \
        libwayland-dev \
        libx11-dev \
        libxcursor-dev \
        libxext-dev \
        libxfixes-dev \
        libxi-dev \
        libxkbcommon-dev \
        libxml2-dev \
        libxrandr-dev \
        libxss-dev \
        libxtst-dev \
        nasm \
        ninja-build \
        patchelf \
        pkg-config \
        python3 \
        wayland-protocols \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Host-architecture (always amd64) mirror of build-base, used only to build
# the shader-compilation toolchain -- see the DXC note at the top of the file.
FROM --platform=${XWA_TOOLS_PLATFORM} debian:bookworm-slim AS build-base-host

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        file \
        git \
        libasound2-dev \
        libdbus-1-dev \
        libdecor-0-dev \
        libdrm-dev \
        libegl1-mesa-dev \
        libgbm-dev \
        libgl-dev \
        libibus-1.0-dev \
        libncurses-dev \
        libpipewire-0.3-dev \
        libpulse-dev \
        libudev-dev \
        liburing-dev \
        libvulkan-dev \
        libwayland-dev \
        libx11-dev \
        libxcursor-dev \
        libxext-dev \
        libxfixes-dev \
        libxi-dev \
        libxkbcommon-dev \
        libxml2-dev \
        libxrandr-dev \
        libxss-dev \
        libxtst-dev \
        nasm \
        ninja-build \
        patchelf \
        pkg-config \
        python3 \
        wayland-protocols \
        xz-utils \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The dependencies build as independent stages so that a version bump only
# rebuilds the affected dependency and so that cold builds run concurrently.

FROM build-base AS sdl-build

ARG SDL_VERSION

RUN git clone --branch "release-${SDL_VERSION}" --depth 1 \
        https://github.com/libsdl-org/SDL.git /deps/SDL \
    && cmake -S /deps/SDL -B /build/sdl -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xwa-linux \
        -DSDL_INSTALL_DOCS=OFF \
        -DSDL_SHARED=ON \
        -DSDL_STATIC=OFF \
        -DSDL_TESTS=OFF \
    && cmake --build /build/sdl --parallel \
    && cmake --install /build/sdl

# Host-architecture SDL, needed only so the amd64 shadercross tool (built in
# the shader-tools stage below) has something to link and run against.
FROM build-base-host AS sdl-build-host

ARG SDL_VERSION

RUN git clone --branch "release-${SDL_VERSION}" --depth 1 \
        https://github.com/libsdl-org/SDL.git /deps/SDL \
    && cmake -S /deps/SDL -B /build/sdl -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xwa-linux \
        -DSDL_INSTALL_DOCS=OFF \
        -DSDL_SHARED=ON \
        -DSDL_STATIC=OFF \
        -DSDL_TESTS=OFF \
    && cmake --build /build/sdl --parallel \
    && cmake --install /build/sdl

FROM build-base AS zstd-build

ARG ZSTD_VERSION

RUN git clone --branch "v${ZSTD_VERSION}" --depth 1 \
        https://github.com/facebook/zstd.git /deps/zstd \
    && cmake -S /deps/zstd/build/cmake -B /build/zstd -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xwa-linux \
        -DZSTD_BUILD_PROGRAMS=OFF \
        -DZSTD_BUILD_SHARED=ON \
        -DZSTD_BUILD_STATIC=OFF \
        -DZSTD_BUILD_TESTS=OFF \
    && cmake --build /build/zstd --parallel \
    && cmake --install /build/zstd

FROM build-base AS ffmpeg-build

ARG FFMPEG_VERSION

RUN git clone --branch "n${FFMPEG_VERSION}" --depth 1 \
        https://github.com/FFmpeg/FFmpeg.git /deps/FFmpeg \
    && cd /deps/FFmpeg \
    && ./configure \
        --prefix=/opt/xwa-linux \
        --disable-autodetect \
        --disable-avdevice \
        --disable-avfilter \
        --disable-debug \
        --disable-doc \
        --disable-everything \
        --disable-network \
        --disable-programs \
        --disable-static \
        --enable-decoder=adpcm_vima \
        --enable-decoder=sanm \
        --enable-demuxer=smush \
        --enable-pic \
        --enable-pthreads \
        --enable-shared \
    && make -j"$(nproc)" \
    && make install

FROM build-base-host AS shader-tools

ARG SHADERCROSS_COMMIT

COPY packaging/common/shadercross-fsr3.patch /tmp/shadercross-fsr3.patch

# DXC 1.9 requires glibc 2.38; keep the Debian 12-compatible 1.8 release.
ARG DXC_VERSION=1.8.2502
ARG DXC_LINUX_X64_ARCHIVE=linux_dxc_2025_02_20.x86_64.tar.gz
ARG DXC_LINUX_X64_SHA256=e0580d90dbf6053a783ddd8d5153285f0606e5deaad17a7a6452f03acdf88c71

ADD --checksum=sha256:${DXC_LINUX_X64_SHA256} \
    https://github.com/microsoft/DirectXShaderCompiler/releases/download/v${DXC_VERSION}/${DXC_LINUX_X64_ARCHIVE} \
    /tmp/dxc.tar.gz

# shadercross links SDL but needs neither zstd nor FFmpeg. This must be the
# host-architecture (amd64) SDL build, since shadercross itself is amd64.
COPY --from=sdl-build-host /opt/xwa-linux /opt/xwa-linux

RUN git clone https://github.com/libsdl-org/SDL_shadercross.git /deps/SDL_shadercross \
    && git -C /deps/SDL_shadercross checkout "${SHADERCROSS_COMMIT}" \
    && git -C /deps/SDL_shadercross apply /tmp/shadercross-fsr3.patch \
    && git -C /deps/SDL_shadercross submodule update --init --depth 1 \
        external/SPIRV-Cross \
    && mkdir -p \
        /deps/SDL_shadercross/external/DirectXShaderCompiler-binaries/linux \
    && tar -xzf /tmp/dxc.tar.gz \
        -C /deps/SDL_shadercross/external/DirectXShaderCompiler-binaries/linux \
    && cmake -S /deps/SDL_shadercross/external/SPIRV-Cross \
        -B /build/spirv-cross -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xwa-tools \
        -DSPIRV_CROSS_CLI=OFF \
        -DSPIRV_CROSS_ENABLE_TESTS=OFF \
        -DSPIRV_CROSS_SHARED=ON \
        -DSPIRV_CROSS_STATIC=OFF \
    && cmake --build /build/spirv-cross --parallel \
    && cmake --install /build/spirv-cross \
    && cmake -S /deps/SDL_shadercross -B /build/shadercross -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xwa-tools \
        -DCMAKE_PREFIX_PATH="/opt/xwa-linux;/opt/xwa-tools" \
        -DDirectXShaderCompiler_ROOT=/deps/SDL_shadercross/external/DirectXShaderCompiler-binaries \
        -DSDLSHADERCROSS_CLI=ON \
        -DSDLSHADERCROSS_DXC=ON \
        -DSDLSHADERCROSS_INSTALL=ON \
        -DSDLSHADERCROSS_INSTALL_RUNTIME=OFF \
        -DSDLSHADERCROSS_SHARED=ON \
        -DSDLSHADERCROSS_STATIC=OFF \
        -DSDLSHADERCROSS_SPIRVCROSS_SHARED=ON \
        -DSDLSHADERCROSS_VENDORED=OFF \
    && cmake --build /build/shadercross --parallel \
    && cmake --install /build/shadercross \
    && cp /deps/SDL_shadercross/external/DirectXShaderCompiler-binaries/linux/lib/libdxcompiler.so \
        /deps/SDL_shadercross/external/DirectXShaderCompiler-binaries/linux/lib/libdxil.so \
        /opt/xwa-tools/lib/ \
    # Bundle amd64 SDL3 into the tool's own lib dir so shadercross can find
    # it at runtime even when /opt/xwa-linux in the consuming (xwa-build)
    # stage holds a different architecture's SDL build.
    && cp -L /opt/xwa-linux/lib/libSDL3.so.0 /opt/xwa-tools/lib/

FROM build-base AS xwa-build

ARG TARGETARCH
ARG XWA_BUILD_TYPE=Release
ARG XWA_VERSION=0.0.0-dev

# The amd64 shadercross tool copied in below is dynamically linked. QEMU's
# binfmt handler translates its instructions, but it still needs an actual
# amd64 ELF interpreter and libc on disk to start -- neither exists in this
# arm64 rootfs otherwise. Multiarch installs them under architecture-specific
# paths (/usr/lib/x86_64-linux-gnu/) alongside the native arm64 libraries
# without colliding, and puts the loader at the exact path amd64 binaries
# expect (/lib64/ld-linux-x86-64.so.2). Skipped when the target itself is
# amd64, since shadercross then already matches the stage's native arch.
RUN if [ "${TARGETARCH}" != "amd64" ]; then \
        dpkg --add-architecture amd64 \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
            libc6:amd64 \
            libgcc-s1:amd64 \
            libstdc++6:amd64 \
            zlib1g:amd64 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY --from=sdl-build /opt/xwa-linux /opt/xwa-linux
COPY --from=zstd-build /opt/xwa-linux /opt/xwa-linux
COPY --from=ffmpeg-build /opt/xwa-linux /opt/xwa-linux
COPY --from=sdl-build /deps/SDL/LICENSE.txt /opt/xwa-licenses/SDL3.txt
COPY --from=zstd-build /deps/zstd/LICENSE /opt/xwa-licenses/zstd.txt
COPY --from=ffmpeg-build /deps/FFmpeg/COPYING.LGPLv2.1 /opt/xwa-licenses/FFmpeg-LGPL-2.1.txt
# amd64 shadercross tool + its own bundled amd64 SDL/DXC libs (see the note
# in the shader-tools stage). Executing it below requires binfmt/QEMU when
# XWA_BUILD_PLATFORM isn't linux/amd64.
COPY --from=shader-tools /opt/xwa-tools /opt/xwa-tools
COPY CMakeLists.txt /src/CMakeLists.txt
COPY README.md /src/README.md
COPY aeron /src/aeron
COPY cmake /src/cmake
COPY resources /src/resources
COPY shaders /src/shaders
COPY src /src/src

# /opt/xwa-tools/lib is searched first so the amd64 shadercross process picks
# up its bundled amd64 SDL3/DXC libs; /opt/xwa-linux/lib holds the
# target-architecture SDL/zstd/FFmpeg used to link OpenXWA itself. The
# dynamic linker skips libraries with a mismatched ELF machine type and
# keeps searching, so each binary transparently finds only its own
# architecture's copy even though both directories are on the same path.
ENV LD_LIBRARY_PATH=/opt/xwa-tools/lib:/opt/xwa-linux/lib
ENV PKG_CONFIG_PATH=/opt/xwa-linux/lib/pkgconfig

RUN case "${XWA_BUILD_TYPE}" in \
        Release) xwa_debug_ui=OFF ;; \
        Debug) xwa_debug_ui=ON ;; \
        *) echo "XWA_BUILD_TYPE must be Release or Debug" >&2; exit 2 ;; \
    esac \
    && cmake -S /src -B /build/xwa -G Ninja \
        -DCMAKE_BUILD_TYPE="${XWA_BUILD_TYPE}" \
        -DCMAKE_PREFIX_PATH=/opt/xwa-linux \
        -DAERON_SHADERCROSS_EXECUTABLE=/opt/xwa-tools/bin/shadercross \
        -DXWA_BUILD_TOOLS=OFF \
        -DXWA_ENABLE_DEBUG_UI="${xwa_debug_ui}" \
    && cmake --build /build/xwa --target xwa --parallel

RUN mkdir -p /build/package/openxwa/licenses \
        /build/package/openxwa/lib \
        /build/package/openxwa/shaders \
    && cp /build/xwa/OpenXWA /build/package/openxwa/ \
    && cp /build/xwa/shaders/*.spv \
        /build/package/openxwa/shaders/ \
    && cp -a /src/resources /build/package/openxwa/ \
    && cp /src/README.md \
        /build/package/openxwa/README.md \
    && cp /opt/xwa-licenses/SDL3.txt \
        /build/package/openxwa/licenses/SDL3.txt \
    && cp /opt/xwa-licenses/zstd.txt \
        /build/package/openxwa/licenses/zstd.txt \
    && cp /opt/xwa-licenses/FFmpeg-LGPL-2.1.txt \
        /build/package/openxwa/licenses/FFmpeg-LGPL-2.1.txt \
    && cp -L /opt/xwa-linux/lib/libSDL3.so.0 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libavcodec.so.62 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libavformat.so.62 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libavutil.so.60 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libswresample.so.6 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libswscale.so.9 \
        /build/package/openxwa/lib/ \
    && cp -L /opt/xwa-linux/lib/libzstd.so.1 \
        /build/package/openxwa/lib/ \
    && patchelf --set-rpath '$ORIGIN/lib' \
        /build/package/openxwa/OpenXWA \
    && for library in /build/package/openxwa/lib/*.so*; do \
        patchelf --set-rpath '$ORIGIN' "$library"; \
    done

RUN test -f /build/package/openxwa/shaders/hyperspace_streak.vert.spv \
    && test -f /build/package/openxwa/shaders/hyperspace_streak.frag.spv \
    && test -f /build/package/openxwa/resources/remaster/config.yaml \
    && file /build/package/openxwa/OpenXWA \
    && env -u LD_LIBRARY_PATH ldd /build/package/openxwa/OpenXWA \
    && ! env -u LD_LIBRARY_PATH \
        ldd /build/package/openxwa/OpenXWA | grep -q "not found" \
    # The GCC runtime must resolve from the host, never from the package: the
    # host's Mesa Vulkan ICDs dlopen into the process and bind whichever
    # libstdc++ is already loaded, so a bundled (older) copy breaks Vulkan
    # device enumeration on newer distros.
    && ! env -u LD_LIBRARY_PATH \
        ldd /build/package/openxwa/OpenXWA \
        | grep -E 'libstdc[+][+]|libgcc_s' | grep -q '/build/package' \
    # Host baseline contract: glibc 2.35 and the GCC 12 runtime (Ubuntu 22.04
    # era). Fail packaging if any shipped object requires newer symbol
    # versions, or the glibc-2.36-only DT_RELR ABI, so a toolchain or
    # dependency bump cannot silently raise the floor.
    && for object in /build/package/openxwa/OpenXWA \
        /build/package/openxwa/lib/*.so*; do \
        if readelf -V "$object" | grep -q 'GLIBC_ABI_'; then \
            echo "$object requires a GLIBC_ABI_* version (DT_RELR needs glibc 2.36+)" >&2; \
            exit 1; \
        fi; \
        for bound in GLIBC_2.35 GLIBCXX_3.4.30 CXXABI_1.3.13; do \
            required=$(readelf -V "$object" \
                | grep -oE "${bound%_*}_[0-9][0-9.]*" | sort -uV | tail -n 1); \
            if [ -n "$required" ] && \
                [ "$(printf '%s\n%s\n' "$required" "$bound" | sort -V | tail -n 1)" != "$bound" ]; then \
                echo "$object requires $required, above the $bound host baseline" >&2; \
                exit 1; \
            fi; \
        done; \
    done \
    && if [ "${XWA_BUILD_TYPE}" = Debug ]; then \
        readelf --sections /build/package/openxwa/OpenXWA \
            | grep -q '\.debug_info'; \
    fi \
    && if [ "${XWA_BUILD_TYPE}" = Debug ]; then \
        artifact_variant=debug; \
    else \
        artifact_variant=release; \
    fi \
    # Map Docker's TARGETARCH to the conventional `uname -m` string used in
    # the release archive/directory name.
    && case "${TARGETARCH}" in \
        amd64) xwa_arch_name=x86_64 ;; \
        arm64) xwa_arch_name=aarch64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 2 ;; \
    esac \
    && package_name="openxwa-${XWA_VERSION}-linux-${xwa_arch_name}-${artifact_variant}" \
    && mv /build/package/openxwa "/build/package/${package_name}" \
    && mkdir -p /build/artifacts \
    && tar \
        --sort=name \
        --mtime="@0" \
        --owner=0 \
        --group=0 \
        --numeric-owner \
        -C /build/package \
        -cJf "/build/artifacts/${package_name}.tar.xz" \
        "${package_name}" \
    && tar -tJf "/build/artifacts/${package_name}.tar.xz"

FROM scratch AS artifact
COPY --from=xwa-build /build/artifacts/ /
